# Copy to .env.local for local development (never commit .env.local).
# On Vercel, set these in Project → Settings → Environment Variables.
# Every variable here is SERVER-SIDE ONLY, except the NEXT_PUBLIC_FIREBASE_* web
# config, which is public by design. Never add NEXT_PUBLIC_ to anything else.

# --- Data -------------------------------------------------------------------
# "airtable" (default, current source of truth), "firestore" (only AFTER the
# migration in docs/firestore-migration.md is verified) or "memory"
# (DEVELOPMENT PLACEHOLDER with sample data that disappears on restart; refused
# in production). Exactly one is active, so data is never written to two places.
DATA_BACKEND=airtable

# Airtable personal access token (https://airtable.com/create/tokens)
# Scopes: data.records:read, data.records:write, schema.bases:read
# Access: ONLY the NMU onboarding base.
AIRTABLE_TOKEN=
# Base ID, starts with "app" (found in the base's URL)
AIRTABLE_BASE_ID=

# --- Sessions ---------------------------------------------------------------
# Random string, at least 32 characters. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
SESSION_SECRET=

# --- Sign-in ----------------------------------------------------------------
# Firebase Authentication: "Continue with Google" and email/password (see docs/firebase.md).
# 1) Web app config — PUBLIC values (Firebase Console → Project settings →
#    General → Your apps → Web app → SDK setup and configuration → Config).
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
# 2) Admin SDK service account — SECRET (Project settings → Service accounts →
#    Generate new private key). Copy three fields from the JSON, then DELETE the
#    downloaded file. Paste the private key on one line with literal \n escapes.
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=

# Local Firebase emulators (`npm run emulators`). LOCAL ONLY — refused in production.
# FIREBASE_AUTH_EMULATOR_HOST=127.0.0.1:9099
# FIRESTORE_EMULATOR_HOST=127.0.0.1:8080
# NEXT_PUBLIC_FIREBASE_AUTH_EMULATOR_HOST=127.0.0.1:9099

# Email-only sign-in without a password, for LOCAL DEVELOPMENT ONLY.
# Ignored whenever VERCEL_ENV=production or APP_ENV=production.
ALLOW_DEV_SIGN_IN=false

# --- Deployment -------------------------------------------------------------
# Public URL of the app, used to check that sign-in requests come from it, e.g. https://nmu-onboarding.vercel.app
APP_URL=
# Set to "production" when hosting somewhere other than Vercel.
APP_ENV=
