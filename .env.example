# Copy to .env.local for local development (never commit .env.local).
# On Vercel, set these in Project → Settings → Environment Variables.
# Every variable here is SERVER-SIDE ONLY. Never prefix them with NEXT_PUBLIC_.

# --- Data -------------------------------------------------------------------
# "airtable" (default, real data) or "memory" (DEVELOPMENT PLACEHOLDER with
# sample data that disappears on restart; refused in production).
DATA_BACKEND=airtable

# Airtable personal access token (https://airtable.com/create/tokens)
# Scopes: data.records:read, data.records:write, schema.bases:read
# Access: ONLY the NMU onboarding base.
AIRTABLE_TOKEN=
# Base ID, starts with "app" (found in the base's URL)
AIRTABLE_BASE_ID=

# --- Sessions ---------------------------------------------------------------
# Random string, at least 32 characters. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
SESSION_SECRET=

# --- Sign-in ----------------------------------------------------------------
# Google sign-in (Google Cloud Console → APIs & Services → Credentials →
# OAuth client ID → Web application). Authorized redirect URI:
#   https://<your-domain>/auth/google/callback   (and http://localhost:3000/auth/google/callback)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Optional: only allow accounts from this Google Workspace domain, e.g. nomoreunder.org
GOOGLE_ALLOWED_DOMAIN=

# Email-only sign-in without a password, for LOCAL DEVELOPMENT ONLY.
# Ignored whenever VERCEL_ENV=production or APP_ENV=production.
ALLOW_DEV_SIGN_IN=false

# Demo accounts for testers (optional; works on the live site). Users rows whose
# email ends in @example.com can be signed into with this shared password, so
# testers can see the Admin and Staff views. 16+ characters, random. Generate with:
#   openssl rand -base64 24
# Delete this variable to turn demo accounts off. Demo accounts can't use
# Google Calendar or Google Sheets.
DEMO_PASSWORD=

# --- Google Calendar sync (optional) ---------------------------------------
# Uses the SAME Google OAuth client as sign-in. In Google Cloud Console:
#   1. Enable the "Google Calendar API" for the project.
#   2. Add this extra authorized redirect URI to the OAuth client:
#        https://<your-domain>/auth/google/calendar/callback
#        (and http://localhost:3000/auth/google/calendar/callback for local testing)
#   3. Add the scopes calendar.events.owned and calendar.calendarlist.readonly
#      to the OAuth consent screen. See docs/google-calendar.md.
# 32-byte key that encrypts Google refresh tokens before they're stored. Generate with:
#   openssl rand -base64 32
# Changing it later disconnects everyone (they just reconnect).
TOKEN_ENCRYPTION_KEY=
# Random string (16+ characters). Vercel Cron sends it as "Authorization: Bearer <CRON_SECRET>"
# to /api/cron/calendar-sync. Generate like SESSION_SECRET.
CRON_SECRET=

# --- Deployment -------------------------------------------------------------
# Public URL of the app, used to build the Google redirect URI, e.g. https://nmu-onboarding.vercel.app
APP_URL=
# Set to "production" when hosting somewhere other than Vercel.
APP_ENV=

# --- Google Sheets export (optional) ---------------------------------------
# Reuses GOOGLE_CLIENT_ID / GOOGLE_CLIENT_SECRET and SESSION_SECRET above.
# Enable Google Sheets API and add the drive.file scope to OAuth consent.
# Add exact callback: https://<your-domain>/auth/google/sheets/callback
# Local example: http://localhost:3000/auth/google/sheets/callback
# This feature needs no refresh token or new secret. APP_URL must match the origin.
# See docs/google-sheets-export.md for setup and live acceptance checks.
